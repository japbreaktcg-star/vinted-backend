generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active") // permet la désactivation manuelle depuis l'admin
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Réinitialisation de mot de passe
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  // Code affilié utilisé à l'inscription (pour suivre les parrainages d'influenceurs)
  affiliateCodeId String?        @map("affiliate_code_id")
  affiliateCode   AffiliateCode? @relation(fields: [affiliateCodeId], references: [id])

  subscription  Subscription?
  refreshTokens RefreshToken[]

  @@map("users")
}

// Code de réduction/parrainage donné à un influenceur. Le code de réduction réel est géré côté Stripe
// (stripePromotionCodeId) — cette table sert à savoir qui a ramené qui, pour calculer les commissions.
model AffiliateCode {
  id                    String   @id @default(uuid())
  code                  String   @unique // ex: "POKEMON10", affiché tel quel à l'influenceur
  influencerName        String   @map("influencer_name")
  influencerEmail       String?  @map("influencer_email")
  discountPercent       Int      @map("discount_percent") // % de réduction pour la personne qui utilise le code
  commissionPercent     Int      @map("commission_percent") // % de commission reversé à l'influenceur
  stripePromotionCodeId String?  @map("stripe_promotion_code_id")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")

  users User[]

  @@map("affiliate_codes")
}

model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @unique @map("user_id")
  stripeCustomerId     String    @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  status               String    @default("none") // none | active | trialing | past_due | canceled | unpaid
  currentPeriodStart   DateTime? @map("current_period_start")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// Sessions/refresh tokens pour l'auth (étape 3) — prévu dès maintenant pour éviter une migration cassante plus tard
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
